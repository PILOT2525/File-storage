{
  "manifest_version": 3,
  "name": "Userscript Runner",
  "version": "1.1",
  "description": "userscriptを貼り付けて保存・実行できる拡張機能",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
